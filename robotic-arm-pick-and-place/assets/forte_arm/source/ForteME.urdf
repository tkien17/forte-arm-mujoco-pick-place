    <axis xyz="1 0 0"/>
    <limit effort="10" velocity="0.1" lower="-0.03" upper="0.02"/>
    <!-- Both slider axes point along gripper-base +Y. Opposite travel keeps
         the CAD fingers centered: q_right = -q_left (one gripper input). -->
    <mimic joint="l_gripper_linear_joint" multiplier="-1" offset="0"/>
  </joint>

  <!-- right gripper link -->
  <link name="r_end_effector_link">
  <inertial>
  <origin xyz="0.0300034 0.01332065 -0.01350307" rpy="0 0 0"/>
  <mass value="0.04826781"/>
  <inertia ixx="8.90704e-06" ixy="5.13890e-07" ixz="2.75196e-06" iyy="2.662607e-05" iyz="-5.04000e-09" izz="2.429253e-05"/>
  </inertial>
  <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5707963267948966"/>
      <geometry>
        <mesh filename="r_end_effector_link.stl"/>
      </geometry>
      <material name="torso_parts_material">
        <color rgba="0.723666 0.709829 0.56081 1"/>
      </material>
    </visual>
    <!-- Separate slider and finger pieces preserve the grasping face and root clearance. -->
    <collision name="r_finger_slider_plate">
      <origin xyz="0.015 -0.00185 0.0" rpy="0 0 -1.5707963267948966"/>
      <geometry>
        <box size="0.0037 0.06 0.006"/>
      </geometry>
    </collision>
    <collision name="r_finger_root_attachment">
      <origin xyz="0.02825 -0.0071 -0.00525" rpy="0 0 -1.5707963267948966"/>
      <geometry>
        <box size="0.007 0.0245 0.0165"/>
      </geometry>
    </collision>
    <collision name="r_finger_mount_transition">
      <origin xyz="0.02825 -0.0153 -0.01" rpy="0 0 -1.5707963267948966"/>
      <geometry>
        <box size="0.0094 0.0245 0.042"/>
      </geometry>
    </collision>
    <collision name="r_finger_finger_body">
      <origin xyz="0.02005 -0.04 -0.01" rpy="0 0 -1.5707963267948966"/>
      <geometry>
        <box size="0.04 0.0081 0.042"/>
      </geometry>
    </collision>
    <collision name="r_finger_finger_taper">
      <origin xyz="0.0188 -0.0675 -0.01" rpy="0 0 -1.5707963267948966"/>
      <geometry>
        <box size="0.015 0.0056 0.033"/>
      </geometry>
    </collision>
    <collision name="r_finger_finger_tip">
      <origin xyz="0.0175 -0.0793 -0.01" rpy="0 0 -1.5707963267948966"/>
      <geometry>
        <box size="0.0086 0.003 0.021"/>
      </geometry>
    </collision>
  </link>
</robot>

